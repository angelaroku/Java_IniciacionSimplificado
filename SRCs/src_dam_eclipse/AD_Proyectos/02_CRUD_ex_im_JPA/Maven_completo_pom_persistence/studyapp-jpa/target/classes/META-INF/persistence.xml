<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

	<persistence-unit name="StudyAppPU" transaction-type="RESOURCE_LOCAL">
		<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
		
		<class>ies.piobaroja.dam2.accesoadatos.studyapp.modelo.Coleccion</class>
		<class>ies.piobaroja.dam2.accesoadatos.studyapp.modelo.Caja</class>
		<class>ies.piobaroja.dam2.accesoadatos.studyapp.modelo.Ficha</class>
		
		<properties>
			<property name="javax.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/studyapp_db"/>
			<property name="javax.persistence.jdbc.user" value="root"/>
			<property name="javax.persistence.jdbc.password" value=""/>
			<property name="javax.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>
			
			<property name="hibernate.dialect" value="org.hibernate.dialect.MariaDB102Dialect"/>
			<property name="hibernate.connection.driver_class" value="org.mariadb.jdbc.Driver"/>
			
			<property name="hibernate.show_sql" value="true"/>
			<property name="hibernate.format_sql" value="true"/>
			
			<property name="hibernate.hbm2ddl.auto" value="update"/>
		</properties>
	</persistence-unit>
</persistence>